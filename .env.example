# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sih"

# Optional: separate database used by integration tests.
# If unset, database-constraint integration tests are skipped.
TEST_DATABASE_URL=""

# Session cookie configuration.
SESSION_COOKIE_NAME="sih_session"
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# File storage driver: "local" (Phase 1) | "s3" (future).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/local"

# AI provider: "none" | "deterministic" (Phase 1 default). The platform
# works fully without any AI configuration.
AI_PROVIDER="deterministic"
# Future providers add credentials here (e.g. AI_API_KEY). Never required.

# Seed controls (development). Disabled in production.
SEED_DEMO_DATA="true"